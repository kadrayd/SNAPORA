{
  "expo": {
    "name": "SNAPORA",
    "slug": "SNAPORA",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "scheme": "snapora",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "SNAPORA kameranıza erişim izni istiyor.",
          "microphonePermission": "SNAPORA mikrofonunuza erişim izni istiyor."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "SNAPORA fotoğraflarınıza erişim izni istiyor."
        }
      ]
    ]
  }
}
